# Required — three bots from @BotFather
FRONTEND_BOT_TOKEN=123456:frontend-token
BACKEND_BOT_TOKEN=123456:backend-token
QA_BOT_TOKEN=123456:qa-token

# Required — numeric group id. Supergroups use -100…; shorter ids from some tools are accepted too.
TELEGRAM_GROUP_CHAT_ID=-1001234567890

# Optional — local repos (defaults under C:\Users\user\projects\)
FRONTEND_REPO=C:\Users\user\projects\events-community-frontend
BACKEND_REPO=C:\Users\user\projects\events-community-backend
DATABASE_PATH=agents.sqlite3
GIT_REMOTE=origin

# Phase 1 — sandbox root for filesystem tools. Default matches PROJECTS_DIR when unset (see app.config).
WORKSPACE_DIR=C:/Users/user/projects
FILE_TOOLS_ENABLED=false
TOOL_CHAT_MAX_ROUNDS=6
# Tool loop: each round resends the full transcript. Cap how much of each assistant JSON is stored (0 = unlimited). Default 12000.
# TOOL_CHAT_ASSISTANT_RAW_MAX_CHARS=4096
# Max chars of each tool result (read_file, list_files, etc.) injected into the model transcript. Default 12000 — must cover enough of large files to edit; lower saves tokens but can cause retry loops.
# TOOL_CHAT_TOOL_RESULT_MAX_CHARS=12000

# Phase 2 — subprocess tools (whitelist, cwd under workspace, optional Telegram approvals).
TERMINAL_TOOLS_ENABLED=true
TERMINAL_TIMEOUT_SEC=300
TERMINAL_STREAM_INTERVAL_SEC=2.5

# Phase 3 — GitPython git_* tools (push requires /approve_git_push), task workflow from @mentions.
GIT_TOOLS_ENABLED=true
# frontend|backend @mention → IN_PROGRESS task + tool loop + REVIEW/DONE (needs FILE_TOOLS_ENABLED=true).
WORKFLOW_FROM_MENTIONS=false
# After fe/be tasks reach REVIEW (or mention workflow), auto-queue a QA task.
AUTO_QA_REVIEW_TASK=true
# Reserved flags for future merge / deploy dual-control (see docs).
MERGE_APPROVAL_REQUIRED=false
PRODUCTION_APPROVAL_REQUIRED=false

# Phase 4 — Playwright browser tools (frontend + QA). After pip install, run: playwright install chromium
BROWSER_TOOLS_ENABLED=true
BROWSER_DEFAULT_TIMEOUT_MS=30000
BROWSER_MAX_RETRIES=3
BROWSER_RETRY_DELAY_SEC=0.5
# Comma-separated hostnames allowed for browser_open_page (no scheme)
BROWSER_URL_ALLOWLIST=localhost,127.0.0.1,::1

# AI — PRD-style provider switch (see PRD.md §7).
# codex_cli: runs `codex exec`. gemini: Google generateContent. openai: Chat Completions + json_object for tool loops.
AI_PROVIDER=codex_cli
# Required for openai (use your sk-... key). Gemini falls back to GEMINI_API_KEY if AI_API_KEY is empty.
AI_API_KEY=
GEMINI_API_KEY=
# Model id: e.g. gpt-4o for openai; gemini-2.0-flash for gemini; for codex_cli passed as --model when CODEX_MODEL is empty.
AI_MODEL=
# Optional: OpenAI Chat Completions max output tokens (lower = cheaper; tool JSON with big write_file may need headroom).
# AI_MAX_OUTPUT_TOKENS_CHAT=400
# AI_MAX_OUTPUT_TOKENS_ORCHESTRATION=8192
# AI_MAX_OUTPUT_TOKENS=1024
# Optional: OpenAI-compatible base (default https://api.openai.com/v1). Gemini uses generateContent URL unless overridden.
# AI_BASE_URL=https://api.openai.com/v1

# Optional: overrides AI_MODEL for codex_cli only (`codex exec --model`).
CODEX_MODEL=

# Per-agent persona (optional). Use *_PERSONA for inline text or *_PERSONA_FILE for a UTF-8 text file path.
# FRONTEND_PERSONA=
# FRONTEND_PERSONA_FILE=
# BACKEND_PERSONA=
# BACKEND_PERSONA_FILE=
# QA_PERSONA=
# QA_PERSONA_FILE=

# Per-agent AI overrides (optional). When CODEX_MODEL is unset, FRONTEND_AI_MODEL etc. override AI_MODEL for that bot.
# FRONTEND_AI_MODEL=
# BACKEND_AI_MODEL=
# QA_AI_MODEL=
# FRONTEND_AI_PROVIDER=codex_cli
# BACKEND_AI_PROVIDER=gemini
# QA_AI_PROVIDER=codex_cli

# Recent tasks + handoffs injected into implementation prompts (set MAX_TASKS to 0 to disable).
# PROMPT_CONTEXT_MAX_TASKS=5
# PROMPT_CONTEXT_MAX_CHARS=6000

# After verification, run an extra read-only LLM QA narrative (codex_cli: read-only sandbox; gemini: JSON review).
# QA_AI_REVIEW=false
